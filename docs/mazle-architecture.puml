@startuml
title Mazle Architecture (Current + Planned)
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam rectangleBackgroundColor #F7F7F7

actor Player as P

rectangle "Client (Browser)" as CLIENT {
  component "Next.js UI\n(Phaser Game)" as UI
  component "WASM Generator\n(fallback)" as WASM
}

rectangle "Vercel" as VERCEL {
  component "Next.js API Routes" as API
  component "Daily Cache API\nGET /api/daily" as DAILY_API
  component "Daily Cache Backfill\nPOST /api/daily/cache" as DAILY_CACHE_API
  component "Cron Generate\nGET /api/cron/generate" as CRON_API
  component "Vercel Cron\n(11 PM ET)" as VERCEL_CRON
  component "Auth.js OIDC" as AUTH
  component "Stripe Webhook" as STRIPE_WEBHOOK
  component "Leaderboard API" as LB_API
  component "Archive API" as ARCHIVE_API
}

rectangle "External Identity" as OIDC {
  component "Google OIDC" as GOOGLE
  component "Apple OIDC" as APPLE
}

rectangle "Data Stores" as DATA {
  database "Upstash Redis\n(Daily Puzzle Cache)\n(DB 1)" as REDIS_KV
  database "Upstash Redis Global\n(Daily Leaderboard)\n(DB 2)" as REDIS_LB
  database "Neon Postgres\n(accounts, entitlements, archive)" as DB
}

rectangle "Payments" as PAY {
  component "Stripe Checkout" as STRIPE_CHECKOUT
  component "Stripe Events" as STRIPE_EVENTS
}

rectangle "Generator (Fly.io)" as GEN {
  component "Rust Generator API" as RUST_GEN
  component "In-memory Cache\n(48h TTL)" as GEN_CACHE
  component "Pre-gen Scheduler\n(10 PM ET)" as GEN_CRON
}

rectangle "Ops/Jobs (planned)" as JOBS {
  component "Leaderboard\nSnapshot Job" as SNAPSHOT
}

P --> UI
UI --> DAILY_API : fetch daily puzzle
UI --> RUST_GEN : fallback if KV miss
UI --> WASM : fallback generation
UI --> DAILY_CACHE_API : backfill KV
UI --> LB_API : submit/read leaderboard
UI --> ARCHIVE_API : calendar/history
UI --> AUTH : sign-in / claim
UI --> STRIPE_CHECKOUT : purchase archive

AUTH --> GOOGLE
AUTH --> APPLE

DAILY_API --> REDIS_KV : GET puzzle:{date}
DAILY_CACHE_API --> REDIS_KV : SET NX puzzle:{date}
CRON_API --> RUST_GEN : generate today/tomorrow
CRON_API --> REDIS_KV : SET puzzle:{date} (no TTL)
VERCEL_CRON --> CRON_API : scheduled call

GEN_CRON --> RUST_GEN : precompute daily seeds
RUST_GEN --> GEN_CACHE : read/write cached puzzles

LB_API --> REDIS_LB : zadd/zrange (lb:YYYY-MM-DD)
LB_API --> DB : snapshots/history
ARCHIVE_API --> DB : historical puzzles (planned)
ARCHIVE_API ..> REDIS_KV : optional hot cache

STRIPE_CHECKOUT --> STRIPE_EVENTS
STRIPE_EVENTS --> STRIPE_WEBHOOK
STRIPE_WEBHOOK --> DB : entitlements, purchases

SNAPSHOT --> REDIS_LB : read top N
SNAPSHOT --> DB : write snapshots

note right of REDIS_KV
Upstash Redis is the KV cache today.
Daily puzzles stored with no TTL
for the all-time calendar.
end note

note right of REDIS_LB
Daily global leaderboard (separate DB).
Writes replicate to regions.
end note

note right of GEN_CACHE
Fly.io pre-gen warms in-memory cache
1 hour before Vercel cron (10 PM ET).
end note

note right of ARCHIVE_API
Calendar can read from Postgres (planned).
If desired, recent days can be served from Redis.
end note

note right of AUTH
JWT session strategy
HttpOnly cookie
10-day maxAge
end note

@enduml
