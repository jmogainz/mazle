@startuml
title Mazle Architecture (Auth + Stripe + Leaderboard)
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam rectangleBackgroundColor #F7F7F7

actor Player as P

rectangle "Client (Browser)" as CLIENT {
  component "Next.js UI\n(Phaser Game)" as UI
  component "WASM Generator\n(fallback)" as WASM
}

rectangle "Vercel" as VERCEL {
  component "Next.js Serverless\nAPI Routes" as API
  component "Auth.js\nOIDC" as AUTH
  component "Stripe Webhook\nHandler" as STRIPE_WEBHOOK
  component "Leaderboard API\n(Read/Write)" as LB_API
  component "Archive API\n(Calendar)" as ARCHIVE_API
}

rectangle "External Identity" as OIDC {
  component "Google OIDC" as GOOGLE
  component "Apple OIDC" as APPLE
}

rectangle "Data Stores" as DATA {
  database "Neon Postgres" as DB
  database "Upstash Redis\n(Global)" as REDIS
}

rectangle "Payments" as PAY {
  component "Stripe Checkout" as STRIPE_CHECKOUT
  component "Stripe Events" as STRIPE_EVENTS
}

rectangle "Generator" as GEN {
  component "Rust Generator\n(Fly.io)" as RUST_GEN
}

rectangle "Ops/Jobs" as JOBS {
  component "Daily Puzzle\nCron" as CRON
  component "Leaderboard\nSnapshot Job" as SNAPSHOT
}

P --> UI
UI --> API : gameplay, scores
UI --> AUTH : sign-in / claim
UI --> STRIPE_CHECKOUT : purchase archive
UI --> RUST_GEN : puzzle generate (HTTP)
UI --> WASM : fallback generation

AUTH --> GOOGLE
AUTH --> APPLE

API --> DB : users, puzzles, entitlements
LB_API --> REDIS : zadd/zrange
LB_API --> DB : snapshot reads
ARCHIVE_API --> DB : historical puzzles

STRIPE_CHECKOUT --> STRIPE_EVENTS
STRIPE_EVENTS --> STRIPE_WEBHOOK
STRIPE_WEBHOOK --> DB : entitlements, purchases

CRON --> DB : daily puzzle seed
SNAPSHOT --> DB : leaderboard snapshot
SNAPSHOT --> REDIS : read top N

note right of REDIS
Primary writes + global replicas
Allow seconds of drift
end note

note right of AUTH
JWT session strategy
HttpOnly cookie
10-day maxAge
end note

@enduml

